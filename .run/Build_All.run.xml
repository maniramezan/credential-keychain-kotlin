<component name="ProjectRunConfigurationManager">
  <!-- Compiles every module and runs JVM, macOS native, and Android host tests, ktlint, and coverage. -->
  <configuration default="false" name="Build All" type="GradleRunConfiguration" factoryName="Gradle">
    <ExternalSystemSettings>
      <option name="executionName" />
      <option name="externalProjectPath" value="$PROJECT_DIR$" />
      <option name="gradleJvm" value="#GRADLE_LOCAL_JAVA_HOME" />
      <option name="module" value="credential-keychain-kotlin" />
      <option name="tasks" value="build" />
      <option name="vmOptions" />
    </ExternalSystemSettings>
    <DebuggingEnabled>true</DebuggingEnabled>
  </configuration>
</component>
