root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
ktlint_code_style = ktlint_official
# Permit existing wildcard imports for generated native bindings and kotlin.test.
ktlint_standard_no-wildcard-imports = disabled
